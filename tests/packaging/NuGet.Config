<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    The consumers restore FreeTierMail packages only from the folder `dotnet pack -o artifacts/packages`
    writes, never from nuget.org, so they test the packages this commit built. Everything else,
    including the Native AOT compiler packages, still comes from nuget.org.
  -->
  <packageSources>
    <clear />
    <add key="local" value="../../artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <clear />
    <packageSource key="local">
      <package pattern="FreeTierMail" />
      <package pattern="FreeTierMail.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
