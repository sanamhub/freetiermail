<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>FreeTierMail.Mailgun</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>FreeTierMail.Mailgun</PackageId>
    <Description>Mailgun provider for FreeTierMail: sends transactional email through the Mailgun HTTP API and reports quota, throttling and account problems so the mailer can move to the next provider.</Description>
    <PackageTags>email;transactional;mailgun;freetiermail</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../FreeTierMail/FreeTierMail.csproj" />
    <ProjectReference Include="../FreeTierMail.Extensions.DependencyInjection/FreeTierMail.Extensions.DependencyInjection.csproj" />
    <InternalsVisibleTo Include="FreeTierMail.Mailgun.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
