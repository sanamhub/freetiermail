<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>FreeTierMail.Brevo</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>FreeTierMail.Brevo</PackageId>
    <Description>Brevo provider for FreeTierMail: sends transactional email through the Brevo HTTP API and reports quota, throttling and account problems so the mailer can move to the next provider.</Description>
    <PackageTags>email;transactional;brevo;freetiermail</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../FreeTierMail/FreeTierMail.csproj" />
    <InternalsVisibleTo Include="FreeTierMail.Brevo.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
