<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>FreeTierMail.Smtp</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>FreeTierMail.Smtp</PackageId>
    <Description>SMTP provider for FreeTierMail, through MailKit: any relay with a login, for providers without an HTTP API or as a paid fallback. Tells a failed connection (nothing sent) from a dropped send (maybe sent).</Description>
    <PackageTags>email;smtp;mailkit;freetiermail</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../FreeTierMail/FreeTierMail.csproj" />
    <PackageReference Include="MailKit" />
    <!-- Direct reference so the packed nuspec carries the floor: consumers must not get
         Pkcs 10.0.0 through MailKit (GHSA-846f-f764-76mx, CVE-2026-84008). Version comes from
         Directory.Packages.props; drop both when MimeKit depends on 10.0.13 or later. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <InternalsVisibleTo Include="FreeTierMail.Smtp.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
