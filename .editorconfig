root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md,props,targets,csproj,slnx}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:error
csharp_style_namespace_declarations = file_scoped:error
csharp_prefer_braces = true:suggestion
csharp_style_var_elsewhere = true:suggestion
dotnet_style_readonly_field = true:error
# Interface members are public by definition; a modifier there is noise.
dotnet_style_require_accessibility_modifiers = for_non_interface_members:error

# Naming: private fields _camelCase, constants PascalCase.
dotnet_naming_rule.private_fields_underscore.severity = error
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

# XML docs are required on the public surface; a missing one fails the build.
dotnet_diagnostic.CS1591.severity = error

[tests/**.cs]
dotnet_diagnostic.CS1591.severity = none    # test methods are not public API
dotnet_diagnostic.CA1707.severity = none    # Method_describes_behaviour is the test naming convention
dotnet_diagnostic.CA1515.severity = none    # the test runner needs public classes
dotnet_diagnostic.CA2007.severity = none    # xUnit runs without a synchronisation context
dotnet_diagnostic.CA1062.severity = none    # test inputs are built in the test itself
dotnet_diagnostic.CA1861.severity = none    # inline arrays keep expected values readable
dotnet_diagnostic.CA2000.severity = none    # short-lived test objects end with the run
dotnet_diagnostic.CA1812.severity = none    # stub handlers are created in ways the analyzer cannot see
